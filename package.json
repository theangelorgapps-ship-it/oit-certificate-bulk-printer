{
  "name": "oit-certificate-bulk-printer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:design": "node scripts/verify-design.mjs && node scripts/verify-design.mjs --copy",
    "test:visual": "node scripts/visual-qa.mjs",
    "test:names-import": "node --test tests/names-import.test.mjs && echo 'NAMES_FILE_IMPORT: PASS'",
    "test:oit-bulk": "node --test tests/*.test.mjs && node scripts/verify-source-data.mjs",
    "test:oit-print": "node scripts/print-qa.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
